# Qué procesos de FRRouting arrancan en cada router: OSPF dentro del banco
# y BGP hacia los proveedores (zebra y staticd arrancan siempre). Los routers
# de internet no usan OSPF: el proceso arranca, pero sin configuración no hace nada.
bgpd=yes
ospfd=yes
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
ospfd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
